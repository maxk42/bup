test_keep_retention() {
    # Create 3 backups, keep 2
    "$BUP" "$ASSETS/project-simple" -o "$WORK" >/dev/null 2>&1
    "$BUP" "$ASSETS/project-simple" -o "$WORK" >/dev/null 2>&1
    "$BUP" "$ASSETS/project-simple" -o "$WORK" >/dev/null 2>&1
    local count
    count=$(ls -1 "$WORK"/bak.project-simple.*.tgz 2>/dev/null | wc -l | xargs)
    [ "$count" -eq 3 ] || { echo "Expected 3 backups before retention, got $count"; return 1; }

    "$BUP" "$ASSETS/project-simple" --keep 2 -o "$WORK" >/dev/null 2>&1
    count=$(ls -1 "$WORK"/bak.project-simple.*.tgz 2>/dev/null | wc -l | xargs)
    [ "$count" -eq 2 ] || { echo "Expected 2 backups after --keep 2, got $count"; return 1; }
}

