#!/bin/bash

# test-bup — Comprehensive test suite for the bup backup utility.
# Runs all tests by default, or a filtered subset via -t/--test.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUP="$SCRIPT_DIR/bup"
ASSETS="$SCRIPT_DIR/test-assets"
WORK=""  # set in setup()

# --- Counters ---
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0
TESTS_SKIPPED=0
FAILED_NAMES=()

# --- Options ---
FILTER=""
VERBOSE=false
LIST_TESTS=false
STOP_ON_FAIL=false

DATE=$(date +%Y-%m-%d)

# =========================================================================
show_help() {
    cat << 'EOF'
test-bup — Test suite for the bup backup utility

USAGE:
    test-bup [OPTIONS]

OPTIONS:
    -t, --test PATTERN  Run only tests whose name contains PATTERN (case-
                        insensitive substring match). Can be specified multiple
                        times; a test runs if it matches ANY pattern.
    -l, --list          List all available test names and exit
    -v, --verbose       Show stdout/stderr from each bup invocation
    -x, --fail-fast     Stop on first test failure
    -h, --help          Show this help message

DESCRIPTION:
    Runs a comprehensive suite of tests covering every bup feature and flag.
    Each test executes in an isolated temporary directory that is cleaned up
    automatically on exit.

    Tests are grouped into sections:

    BASIC           Core single-directory backup, help, and error handling
    OUTPUT_DIR      The -o flag for alternate output directories
    VERBOSE         The -v / --verbose flag
    EXCLUDE         The -x, --exclude-vcs, --exclude-artifacts,
                    --exclude-secrets, --exclude-dev, --show-excludes,
                    --show-excluded, and anchored artifact patterns
    DRY_RUN         The -n / --dry-run flag
    MULTI_DIR       Multiple directory arguments
    COMBINED        The --combined flag
    COMPRESSION     The -z / --compress flag (gzip, bzip2, xz, zstd)
    ENCRYPTION      The -e / --encrypt and --recipient flags (requires gpg)
    RETENTION       The --keep and --prune flags
    LIST            The --list and -L / --list-verbose flags
    SAVE_SCRIPT     The -s, -S, and -d flags
    PRE_POST        Automatic .bup-pre.sh and .bup-post.sh execution,
                    and the --no-scripts flag
    NAMING          Automatic conflict-free naming with numeric suffixes
    ATOMIC          Atomic write behavior (temp file + mv)
    SIZE_REPORT     Backup size reporting after creation
    COLOR           Color output and NO_COLOR support
    BACKWARD_COMPAT Backward compatibility with original invocation style
    ERROR           Error handling for invalid inputs

    Tests that require optional tools (gpg, bzip2, xz, zstd) are
    automatically skipped when the tool is not installed.

EXIT CODES:
    0   All tests passed (or were skipped)
    1   One or more tests failed

ENVIRONMENT:
    NO_COLOR        Disable colored test output
    BUP             Override path to the bup binary under test

EXAMPLES:
    test-bup                          # run all tests
    test-bup -t compress              # run only compression tests
    test-bup -t exclude -t retain     # run exclude and retention tests
    test-bup -l                       # list all test names
    test-bup -v -x                    # verbose output, stop on first failure

EOF
}

# =========================================================================
# Color support
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$'\033[0;31m'
    C_GREEN=$'\033[0;32m'
    C_YELLOW=$'\033[1;33m'
    C_CYAN=$'\033[0;36m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RESET=$'\033[0m'
else
    C_RED="" C_GREEN="" C_YELLOW="" C_CYAN="" C_BOLD="" C_DIM="" C_RESET=""
fi

# =========================================================================
# Parse arguments
FILTERS=()

while [ $# -gt 0 ]; do
    case $1 in
        -t|--test)
            [ $# -lt 2 ] && { echo "Error: -t requires a pattern" >&2; exit 1; }
            FILTERS+=("$2")
            shift 2
            ;;
        -l|--list)
            LIST_TESTS=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -x|--fail-fast)
            STOP_ON_FAIL=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option $1" >&2
            echo "Use -h or --help for detailed information" >&2
            exit 1
            ;;
    esac
done

# =========================================================================
# Test infrastructure

setup() {
    WORK=$(mktemp -d)
    export NO_COLOR=1
}

teardown() {
    [ -n "$WORK" ] && rm -rf "$WORK"
    WORK=""
}

trap teardown EXIT

should_run() {
    local name="$1"
    if [ ${#FILTERS[@]} -eq 0 ]; then
        return 0
    fi
    local lower_name
    lower_name=$(echo "$name" | tr '[:upper:]' '[:lower:]')
    for f in "${FILTERS[@]}"; do
        local lower_f
        lower_f=$(echo "$f" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower_name" == *"$lower_f"* ]]; then
            return 0
        fi
    done
    return 1
}

run_test() {
    local name="$1"
    shift

    if ! should_run "$name"; then
        return
    fi

    TESTS_RUN=$((TESTS_RUN + 1))
    printf "  ${C_CYAN}%-50s${C_RESET} " "$name"

    setup
    local output
    local rc=0
    output=$("$@" 2>&1) || rc=$?

    if [ $rc -eq 0 ]; then
        TESTS_PASSED=$((TESTS_PASSED + 1))
        echo "${C_GREEN}PASS${C_RESET}"
        if [ "$VERBOSE" = true ] && [ -n "$output" ]; then
            echo "${C_DIM}${output}${C_RESET}" | sed 's/^/    /'
        fi
    elif [ $rc -eq 77 ]; then
        TESTS_SKIPPED=$((TESTS_SKIPPED + 1))
        TESTS_RUN=$((TESTS_RUN - 1))
        echo "${C_YELLOW}SKIP${C_RESET} ${C_DIM}${output}${C_RESET}"
    else
        TESTS_FAILED=$((TESTS_FAILED + 1))
        FAILED_NAMES+=("$name")
        echo "${C_RED}FAIL${C_RESET}"
        echo "${C_DIM}${output}${C_RESET}" | sed 's/^/    /'
        if [ "$STOP_ON_FAIL" = true ]; then
            teardown
            echo ""
            echo "${C_RED}Stopped on first failure.${C_RESET}"
            exit 1
        fi
    fi
    teardown
}

skip() {
    echo "$*"
    exit 77
}

assert_file_exists() {
    [ -f "$1" ] || { echo "ASSERT: file does not exist: $1"; return 1; }
}

assert_file_not_exists() {
    [ ! -f "$1" ] || { echo "ASSERT: file should not exist: $1"; return 1; }
}

assert_dir_exists() {
    [ -d "$1" ] || { echo "ASSERT: directory does not exist: $1"; return 1; }
}

assert_exit_zero() {
    "$@" >/dev/null 2>&1 || { echo "ASSERT: expected exit 0 from: $*"; return 1; }
}

assert_exit_nonzero() {
    if "$@" >/dev/null 2>&1; then
        echo "ASSERT: expected non-zero exit from: $*"
        return 1
    fi
}

assert_output_contains() {
    local output="$1"
    shift
    local pattern="$1"
    if ! echo "$output" | grep -qF -- "$pattern"; then
        echo "ASSERT: output does not contain '$pattern'"
        echo "OUTPUT: $output"
        return 1
    fi
}

assert_output_not_contains() {
    local output="$1"
    shift
    local pattern="$1"
    if echo "$output" | grep -qF -- "$pattern"; then
        echo "ASSERT: output should not contain '$pattern'"
        echo "OUTPUT: $output"
        return 1
    fi
}

assert_tarball_contains() {
    local tarball="$1" pattern="$2"
    if ! tar -tf "$tarball" 2>/dev/null | grep -q "$pattern"; then
        echo "ASSERT: tarball $tarball does not contain '$pattern'"
        echo "CONTENTS: $(tar -tf "$tarball" 2>/dev/null)"
        return 1
    fi
}

assert_tarball_not_contains() {
    local tarball="$1" pattern="$2"
    if tar -tf "$tarball" 2>/dev/null | grep -q "$pattern"; then
        echo "ASSERT: tarball $tarball should not contain '$pattern'"
        echo "CONTENTS: $(tar -tf "$tarball" 2>/dev/null)"
        return 1
    fi
}

assert_file_count() {
    local dir="$1" pattern="$2" expected="$3"
    local actual
    actual=$(ls -1 "$dir"/$pattern 2>/dev/null | wc -l | xargs)
    if [ "$actual" != "$expected" ]; then
        echo "ASSERT: expected $expected files matching '$pattern' in $dir, got $actual"
        echo "FILES: $(ls -1 "$dir"/$pattern 2>/dev/null)"
        return 1
    fi
}

assert_file_executable() {
    [ -x "$1" ] || { echo "ASSERT: file is not executable: $1"; return 1; }
}

