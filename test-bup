    # Create 3 combined backups, then one more with --keep 2
    "$BUP" "$ASSETS/project-simple" "$ASSETS/project-scripts" --combined -o "$WORK" >/dev/null 2>&1
    "$BUP" "$ASSETS/project-simple" "$ASSETS/project-scripts" --combined -o "$WORK" >/dev/null 2>&1
    "$BUP" "$ASSETS/project-simple" "$ASSETS/project-scripts" --combined -o "$WORK" >/dev/null 2>&1
    local count
    count=$(ls -1 "$WORK"/bak.project-simple+project-scripts.*.tgz 2>/dev/null | wc -l | xargs)
    [ "$count" -eq 3 ] || { echo "Expected 3 combined backups before retention, got $count"; return 1; }

    "$BUP" "$ASSETS/project-simple" "$ASSETS/project-scripts" --combined --keep 2 -o "$WORK" >/dev/null 2>&1
    count=$(ls -1 "$WORK"/bak.project-simple+project-scripts.*.tgz 2>/dev/null | wc -l | xargs)
    [ "$count" -eq 2 ] || { echo "Expected 2 combined backups after --keep 2, got $count"; return 1; }
}

