# =========================================================================
# Run tests

echo ""
echo "${C_BOLD}bup test suite${C_RESET}"
echo "${C_DIM}$(date)${C_RESET}"
echo ""

# Override BUP path if set in environment
[ -n "${BUP_PATH:-}" ] && BUP="$BUP_PATH"

# Verify bup exists
if [ ! -x "$BUP" ]; then
    echo "${C_RED}Error: bup not found at $BUP${C_RESET}" >&2
    exit 1
fi

# Verify test assets exist
if [ ! -d "$ASSETS" ]; then
    echo "${C_RED}Error: test-assets directory not found at $ASSETS${C_RESET}" >&2
    exit 1
fi

SECTION=""
for t in "${ALL_TESTS[@]}"; do
    # Print section headers
    case "$t" in
        test_basic_*)           new_section="BASIC" ;;
        test_output_*)          new_section="OUTPUT_DIR" ;;
        test_verbose_*)         new_section="VERBOSE" ;;
        test_exclude_*|test_show_exclude*) new_section="EXCLUDE" ;;
        test_dry_run_*)         new_section="DRY_RUN" ;;
        test_multi_*)           new_section="MULTI_DIR" ;;
        test_combined_*)        new_section="COMBINED" ;;
        test_compress_*)        new_section="COMPRESSION" ;;
        test_encrypt_*)         new_section="ENCRYPTION" ;;
        test_keep_*|test_prune_*|test_glob_metachar_retention) new_section="RETENTION" ;;
        test_list_*|test_glob_metachar_backup_*|test_glob_metachar_question_*) new_section="LIST" ;;
        test_save_script_*)     new_section="SAVE_SCRIPT" ;;
        test_pre_*|test_post_*|test_no_scripts_*) new_section="PRE_POST" ;;
        test_naming_*|test_backup_inside_*|test_backup_outside_*|test_include_backups_*) new_section="NAMING" ;;
        test_atomic_*)          new_section="ATOMIC" ;;
        test_size_*)            new_section="SIZE_REPORT" ;;
        test_color_*)           new_section="COLOR" ;;
        test_backward_*)        new_section="BACKWARD_COMPAT" ;;
        test_error_*)           new_section="ERROR" ;;
        *)                      new_section="" ;;
    esac
    if [ "$new_section" != "$SECTION" ]; then
        SECTION="$new_section"
        if should_run "$t" || should_run "$SECTION"; then
            echo ""
            echo "${C_BOLD}$SECTION${C_RESET}"
        fi
    fi

    run_test "$t" "$t"
done

# =========================================================================
